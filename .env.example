# 环境变量示例文件
# 用法：cp .env.example .env，然后在 .env 中填入你自己的真实值。
# .env 已被 .gitignore 忽略，请勿把真实密钥写入本文件或提交到仓库。

# ---------------------------------------------------------------
# 运行模式
# ---------------------------------------------------------------
# true（默认）：完全使用可复现的本地样例数据，不访问地图、图片或模型服务。
# false：使用下方真实服务凭据。
DEMO_MODE=true

# ---------------------------------------------------------------
# 大模型（DeepSeek，OpenAI 兼容接口）—— 仅后端使用，绝不能加 VITE_ 前缀
# ---------------------------------------------------------------
# 在 DeepSeek 开放平台创建；ChatGPT Plus 不包含该 API 额度。
DEEPSEEK_API_KEY=
LLM_MODEL_ID=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------
# 地图服务 —— 仅后端使用
# ---------------------------------------------------------------
# 高德 Web 服务 Key：地理编码、POI、距离与备用路径规划。需开通 Web 服务权限。
AMAP_WEB_SERVICE_KEY=

# 百度地图 Web API AK（可选）：跨城交通方式优先参考百度，失败时由高德接管。
BAIDU_MAP_AK=

# ---------------------------------------------------------------
# 凭证签名
# ---------------------------------------------------------------
# 多进程部署时必须为各进程配置相同的稳定随机串，用于签名按天接驳凭证。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
ROUTE_TOKEN_SECRET=

# ---------------------------------------------------------------
# 数据源开关
# ---------------------------------------------------------------
# RailGo 仅限非商业用途，公开页面必须署名；商业部署请设为 false 并替换授权数据源。
RAILGO_ENABLED=true

# ---------------------------------------------------------------
# 浏览器可见配置 —— 会被 Vite 打包进前端，只能放受域名限制的 JS API Key
# 严禁在此处填写 DEEPSEEK_API_KEY 或 AMAP_WEB_SERVICE_KEY。
# ---------------------------------------------------------------
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# 前端开发代理转发到后端（可选，默认 http://127.0.0.1:8000），由 vite.config.ts 读取。
# TRIP_BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------
# 超时与限流（可选，未设置时使用下列默认值）
# ---------------------------------------------------------------
# PROVIDER_TIMEOUT_SECONDS=12
# ROUTE_MIN_INTERVAL_SECONDS=0.4
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=16384

# ---------------------------------------------------------------
# 预留：实景图片授权恢复后才使用，当前版本不读取该变量
# ---------------------------------------------------------------
# UNSPLASH_ACCESS_KEY=
